# Runtime environment for family-events-api. See src/config/env.ts for validation.

NODE_ENV=development
PORT=3001

# Same database the old pipeline writes to (local Supabase stack: 127.0.0.1:55322).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Schema pg-boss manages; matches the U12 worker so both share one job store.
PGBOSS_SCHEMA=pgboss

# Clerk secret key (sk_test_... locally, sk_live_... in production).
# Authenticated routes fail closed when unset.
CLERK_SECRET_KEY=

# Per-job-family cutover flags (U12 worker semantics; see src/pipeline/flags.ts).
# Production: exact "true". Else on unless exact "false". Unflagged = not installed.
CUTOVER_SCRAPE=
CUTOVER_TAG=
CUTOVER_REVIEW=
CUTOVER_DIGEST=
CUTOVER_REMINDERS=
# Set exact true in production to install the internal five-minute notification_queue worker.
# Unlike legacy replacement schedules, notify has no CronGate handoff.
CUTOVER_NOTIFY=
CUTOVER_MAINTENANCE=

# Optional operator failure pings (U3). Both required to send; unset is a no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FAILURE_CHAT_ID=

# Vercel AI Gateway key: one key for tagging, event review, parent tips,
# embeddings and LLM source extraction (default model openai/gpt-6-luna).
# Unset: AI features use keyword/heuristic fallbacks and /admin/dashboard shows
# "No AI key configured". Set it on the Railway API service; see docs/DEPLOYMENT.md.
AI_GATEWAY_API_KEY=

# Legacy direct-provider settings, used only for features assigned an openai,
# ollama or localai model, or when AI_GATEWAY_API_KEY is unset. An explicit
# AI_PROVIDER overrides the gateway for source extraction. See src/pipeline/llm-config.ts.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
OPENAI_API_KEY=

# Optional stock-image provider keys for event enrichment (U29). Unset providers
# are skipped in fallback order; see src/pipeline/stock-images.ts and unsplash.ts.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional extra ingest image hosts (comma-separated), appended to the
# built-in CDN allowlist in src/pipeline/ingestion/enrichment.ts.
SCRAPER_IMAGE_HOST_ALLOWLIST=

# Optional OpenWeatherMap key for GET /v1/plan ranking. Unset is a neutral snapshot.
OPENWEATHER_API_KEY=

# Email notifications (U30); legacy parity defaults exist in code; set for production.
APP_URL=
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# Push delivery (U30). Vault values win when present; these are environment fallbacks.
# PushService applies the legacy default for VAPID_SUBJECT.
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Public origin of the web app; enables CORS for browser calls (unset in local dev).
WEB_ORIGIN=

# Optional Sentry observability. Empty/absent SENTRY_DSN disables initialization and sending.
# Sample rate defaults to 0 and must be between 0 and 1. Environment and release are optional.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=

# Standalone pg-boss dashboard service only. Use separate Railway service variables.
# Built-in Basic Auth and exact read-only mode are mandatory; never commit their values.
PGBOSS_DASHBOARD_AUTH_USERNAME=
PGBOSS_DASHBOARD_AUTH_PASSWORD=
PGBOSS_DASHBOARD_READ_ONLY=1
HOST=0.0.0.0
NODE_EXTRA_CA_CERTS=/app/certs/supabase-prod-ca-2021.crt
