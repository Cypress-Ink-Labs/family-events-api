{
  "name": "family-events-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend API for the Family Events platform (replaces the Supabase Edge Functions + Railway cron pipeline and the TanStack Start server layer).",
  "scripts": {
    "build": "swc src scripts -d dist",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --config oxfmt.json --write src scripts test",
    "format:check": "oxfmt --config oxfmt.json --check src scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "openapi": "pnpm build && node dist/scripts/emit-openapi.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.3"
}
